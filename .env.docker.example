# =============================================================================
# AI PROVISO — Environment Configuration
# Copy this file to .env and fill in all values marked [CHANGE ME]
# NEVER commit .env to Git — it is in .gitignore
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=proviso
POSTGRES_PASSWORD=change-me          # [CHANGE ME] strong password
POSTGRES_PORT=5432

# ── Backend API ───────────────────────────────────────────────
BACKEND_API_PORT=5000
JWT_SECRET=change-me-use-32-chars-minimum   # [CHANGE ME] 32+ char random string

# ── n8n Event Spine ───────────────────────────────────────────
N8N_PORT=5678
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_BASIC_AUTH_USER=proviso
N8N_BASIC_AUTH_PASSWORD=change-me    # [CHANGE ME]
# Shared secret for backend→n8n webhook calls (header: X-Proviso-Token)
N8N_WEBHOOK_TOKEN=proviso-dev-token  # [CHANGE ME] in production

# ── Paperless-NGX (Document Archive ONLY — OCR DISABLED) ──────
PAPERLESS_PORT=8000
PAPERLESS_URL=http://localhost:8000
PAPERLESS_SECRET_KEY=change-me       # [CHANGE ME] 50+ char random string
# PAPERLESS_OCR_MODE is LOCKED to "skip" in docker-compose.yml
# Do NOT override this here. MOD-02 owns all OCR.

# ── Flowise AI Orchestrator ───────────────────────────────────
FLOWISE_PORT=3001
FLOWISE_SECRETKEY=change-me          # [CHANGE ME]

# ── Ollama LLM Runtime ────────────────────────────────────────
# Option A: Use local Ollama (requires --profile local-ai)
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.2:3b
# Option B: Point to Mac M2 (set this and omit --profile local-ai)
# OLLAMA_BASE_URL=http://MacBook-M2.local:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── Redis ─────────────────────────────────────────────────────
REDIS_PORT=6379

# ── OCR Worker ────────────────────────────────────────────────
# stub = log and ACK only (Phase I)
# paddle = PaddleOCR+DocTR ensemble (Week 3-4)
# ensemble = full pipeline with LLM fallback (Week 4+)
OCR_MODE=stub
LOG_LEVEL=INFO

# ── General ───────────────────────────────────────────────────
TIMEZONE=America/Toronto
