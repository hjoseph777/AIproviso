{
  "name": "proviso",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "author": "Harry Joseph",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "M-Files Workflow Ingestion — SOW to Vault",
  "main": "electron/main.cjs",
  "scripts": {
    "predev": "node scripts/free-port.mjs 3000",
    "dev": "vite --host 127.0.0.1 --port 3000 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "preelectron:dev": "node scripts/clean-electron-dev.mjs && node scripts/free-port.mjs 3000",
    "electron:dev": "concurrently --kill-others --success first \"vite --host 127.0.0.1 --port 3000 --strictPort\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "electron:build": "vite build && electron-builder"
  },
  "devDependencies": {
    "@tabler/icons-webfont": "3.44.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "10.4.20",
    "concurrently": "9.2.1",
    "electron": "42.0.1",
    "electron-builder": "26.8.1",
    "postcss": "8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "3.4.17",
    "vite": "^6.3.5",
    "wait-on": "9.0.5",
    "zod": "4.4.3",
    "zustand": "5.0.13"
  },
  "build": {
    "appId": "com.xerox.proviso",
    "productName": "Proviso",
    "icon": "build/icon.ico",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "Proviso_AP_Mockup3.html",
      "scripts/**/*",
      "package.json"
    ]
  },
  "dependencies": {
    "@xstate/react": "6.1.0",
    "@xyflow/react": "^12.9.3",
    "d3-force": "3.0.0",
    "elkjs": "^0.11.1",
    "xstate": "5.32.0",
    "y-websocket": "3.0.0",
    "yjs": "13.6.31"
  }
}
