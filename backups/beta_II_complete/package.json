{
  "name": "proviso",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "M-Files Workflow Ingestion — SOW to Vault",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "vite build && electron-builder"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "4.4.3",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "9.2.1",
    "electron": "42.0.1",
    "electron-builder": "26.8.1",
    "vite": "^6.3.5",
    "wait-on": "9.0.5"
  },
  "build": {
    "appId": "com.xerox.proviso",
    "productName": "Proviso",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis",
      "icon": "public/favicon.svg"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "scripts/**/*",
      "package.json"
    ]
  }
}
