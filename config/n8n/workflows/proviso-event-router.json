{
  "name": "Proviso Event Router",
  "active": true,
  "nodes": [
    {
      "id": "webhook_invoice_received",
      "name": "webhook_invoice_received",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "invoice-received",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "respond_invoice_received",
      "name": "respond_invoice_received",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [500, 300],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"ack\":true,\"event\":\"invoice.received\"}"
      }
    }
  ],
  "connections": {
    "webhook_invoice_received": {
      "main": [
        [
          {
            "node": "respond_invoice_received",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
