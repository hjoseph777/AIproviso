        "responseMode": "lastNode",
        "options": {
          "rawBody": false
        }
      },
      "id": "webhook-invoice-received",
      "name": "Webhook: invoice.received",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 100],
      "webhookId": "proviso-invoice-received"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst event = body.event;\nconst invoiceId = body.invoice_id;\nconst tenantId = body.tenant_id;\nconst correlationId = body.correlation_id;\n\n// Log the event receipt\nconsole.log(`[MOD-07] audit.event received: ${event} | invoice=${invoiceId} | tenant=${tenantId}`);\n\n// Forward to audit trail\nreturn [{ json: { event, invoice_id: invoiceId, tenant_id: tenantId, correlation_id: correlationId, source_module: body.source_module, payload: body.payload, received_at: new Date().toISOString() } }];"
      },
      "id": "process-invoice-received",
      "name": "Process: invoice.received",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 100]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"ack\": true, \"event\": \"invoice.received\", \"received_at\": \"{{ $now.toISOString() }}\" }"
      },
      "id": "respond-invoice-received",
      "name": "Respond: invoice.received",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
